background-color=#303446
text-color=#c6d0f5
border-color=#ca9ee6
progress-color=over #414559
width=420
height=110
padding=10
border-size=2
font=Ubuntu Nerd Font 12
anchor=top-right
outer-margin=20
default-timeout=5000
max-icon-size=32

[urgency=high]
border-color=#e78284

[app-name=wp-vol]
layer=overlay
history=0
anchor=top-center
# Group all volume notifications together
group-by=app-name
# Hide the group-index
format=<b>%s</b>\n%b
background-color=#303446cc
border-size=0
border-radius=10

[app-name=volume group-index=0]
# Only show last notification
invisible=0
