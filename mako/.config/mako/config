background-color=#303446
text-color=#c6d0f5
border-radius=5
progress-color=over #414559
width=420
height=110
padding=10
font=CaskaydiaCove Nerd Font
anchor=top-right
outer-margin=0
default-timeout=5000
max-icon-size=32

[urgency=high]
background-color=#e78284
border-color=#e78284
text-color=#303446

[app-name=wp-vol]
layer=overlay
history=0
anchor=top-center
# Group all volume notifications together
group-by=app-name
# Hide the group-index
format=<b>%s</b>\n%b
background-color=#303446cc
border-size=0
border-radius=10

[app-name=volume group-index=0]
# Only show last notification
invisible=0
