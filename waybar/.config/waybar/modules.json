{
  "hyprland/workspaces": {
    "format": "{icon}",
    "all-outputs": true,
    "format-icons": {
      "active": ""
    }
  },
  "cpu": {
    "interval": 10,
    "format": "cpu {usage}%",
    "tooltip": false
  },
  "memory": {
    "interval": 10,
    "format": "ram {percentage}%"
  },
  "disk": {
    "interval": 10,
    "format": "disks / {percentage_used}%"
  },
  "disk#ssd": {
    "interval": 10,
    "format": "/ssd {percentage_used}%",
    "path": "/mnt/ssd-seagate"
  },
  "group/disks": {
    "orientation": "horizontal",
    "modules": ["disk", "disk#ssd"]
  },
  "wireplumber": {
    "format": "{icon}  {volume}%",
    "format-icons": ["󰝟", "", "", "", "", "", "", "", "", "", ""],
    "format-muted": "󰝟  muted",
    "on-scroll-up": "swayosd-client --output-volume raise",
    "on-scroll-down": "swayosd-client --output-volume lower",
    "on-click-middle": "swayosd-client --output-volume mute-toggle",
    "tooltip": false
  },
  "network": {
    "interval": 10,
    "format-wifi": "{icon} {essid}",
    "format-ethernet": "󰈀",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip": false
  },
  "clock": {
    "format": "{:L%a, %d %b %H:%M}",
    "timezone": "America/Sao_Paulo"
  },
  "tray": {
    "spacing": 3
  },
  "hyprland/window": {
    "format": "{initialClass}",
    "rewrite": {
      "brave-browser": "Brave",
      "com.mitchellh.ghostty": "Terminal",
      "Code": "Visual Studio Code",
      "discord": "Discord",
      "jetbrains-phpstorm": "PhpStorm",
      "Spotify": "Spotify",
      "steam": "Steam"
    }
  }
}
