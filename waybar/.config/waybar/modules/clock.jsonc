{
  "clock": {
    "format": "{:L%d %R}",
    "format-alt": "{:L%A, %x}",
    "timezone": "America/Sao_Paulo",
    "tooltip": false,
  },

  "clock#time": {
    "format": " {:L%H:%M}",
    "timezone": "America/Sao_Paulo",
    "tooltip": false,
  },

  "clock#date": {
    "format": " {:L%a, %d %b}",
    "on-click": "uwsm app -- gnome-calendar",
    "tooltip": false,
  },

  "group/clock": {
    "orientation": "horizontal",
    "modules": ["clock#date", "clock#time"],
  },
}

