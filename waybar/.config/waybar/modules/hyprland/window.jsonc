{
    "hyprland/window": {
        "format": "{class} {title}",
        "rewrite": {
            "(.*).ghostty (.*)": "Terminal",
            "(.*) - Brave": "Brave",
            "(.*) - Slack": "Slack",
            "(.*) Mozilla Firefox": "Mozilla Firefox",
            "(.*) - (.*) - Cursor": "Cursor [$2]",
            "(.*) - (.*) - Visual Studio Code": "Visual Studio Code [$2]",
            "jetbrains-phpstorm (.*)": "PhpStorm",
            "(.*) - Discord": "Discord",
            "steam (.*)": "Steam",
            "org.gnome.Nautilus (.*)": "Files"
        },
        "tooltip": false
    }
}