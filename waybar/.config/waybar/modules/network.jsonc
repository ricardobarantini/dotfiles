{
    "network": {
        "interval": 10,
        "format-ethernet": "󰛳 {ifname}",
        "format-wifi": "{icon} {essid}",
        "format-linked": "󰅛",
        "format-disconnected": "󰲛",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-ethernet": "Interface: {ifname}\nDownload: {bandwidthDownBytes}\nUpload: {bandwidthUpBytes}",
        "tooltip-format-wifi": "Network: {essid}\nDownload: {bandwidthDownBytes}\nUpload: {bandwidthUpBytes}",
        "on-click": "ghostty --title=\"nmtui\" -e nmtui",
        "max-length": 16
    }
}