{
    "layer": "top",
    "margin": "0 0",
    "reload_style_on_change": true,
    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "group/hardware"
    ],
    "modules-right": [
        "tray",
        "wireplumber",
        "clock",
        "group/power"
    ],
    "custom/launcher": {
        "format": "󰣇",
        "on-click": "wofi -show dmenu",
        "tooltip": false
    },
    "hyprland/window": {
        "format": "{initialTitle}",
        "separate-outputs": true
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "default": "",
            "active": ""
        },
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    },
    "group/hardware": {
        "orientation": "horizontal",
        "modules": [
            "cpu",
            "memory",
            "disk",
            "network"
        ]
    },
    "cpu": {
        "format": " {usage}%",
        "on-click": "alacritty -e htop"
    },
    "memory": {
        "format": " {used:0.2f}G/{total:0.2f}G"
    },
    "disk": {
        "format": " {specific_used:0.0f}GB/{specific_total:0.0f}GB",
        "unit": "GB",
        "on-click": "alacritty -e ncdu --color dark /",
        "on-click-middle": "nautilus"
    },
    "network": {
        "format-ethernet": "󰈀 {ifname}",
        "format-disconnect": "",
        "tooltip-format-ethernet": "󰛴 {bandwidthDownBytes}  󰛶 {bandwidthUpBytes}",
        "on-click": "alacritty --title nmtui -e nmtui"
    },
    "tray": {
        "icon-size": 18,
        "spacing": 10
    },
    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-icons": ["󰝟", "", "", ""],
        "on-click": "pavucontrol",
        "on-click-middle": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },
    "clock": {
        "format": "{:%d %b %H:%M}",
        "format-alt": "{:%d %B %H:%M}",
        "timezone": "America/Sao_Paulo",
        "tooltip": false
    },
    "group/power": {
        "orientation": "horizontal",
        "drawer": {
            "click-to-reveal": false
        },
        "modules": [
            "custom/power",
            "custom/reboot",
            "custom/lock"
        ]
    },
    "custom/lock": {
        "format": "",
        "tooltip": false,
        "on-click": "hyprlock"
    },
    "custom/reboot": {
        "format": "󰜉",
        "tooltip": false,
        "on-click": "reboot"
    },
    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "shutdown now"
    }
}