[user]
	email = ricardobarantini@gmail.com
	name = Ricardo Barantini
	signingkey = /home/ricardo/.ssh/id_ed25519.pub
[alias]
	cleanup = "!git branch --merged | grep  -v '\\*\\|master\\|develop\\|staging\\|main' | xargs -n 1 -r git branch -d"
	wip = "commit --message 'wip' --no-verify"
	uncommit = 'reset --soft "HEAD~1"'
[init]
	defaultBranch = main
[gpg]
	format = ssh
[core]
	fileMode = false
