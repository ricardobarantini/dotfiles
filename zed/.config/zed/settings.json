// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "calls": {
    "mute_on_join": true
  },
  "ssh_connections": [
    {
      "host": "192.168.1.160",
      "projects": [
        {
          "paths": ["/home/ebtadmin/workspace/ebt_passport_v3"]
        },
        {
          "paths": ["/home/ebtadmin/workspace/ebt_passport_versions/laravel-10"]
        },
        {
          "paths": ["/home/ebtadmin/workspace/ebt_passport_versions/laravel-12"]
        },
        {
          "paths": ["/home/ebtadmin/workspace/ebtapi_v3"]
        }
      ],
      "nickname": "Dev 1"
    }
  ],

  "ui_font_family": "CaskaydiaCove Nerd Font",
  "ui_font_size": 16,

  "buffer_font_family": "CaskaydiaCove Nerd Font",
  "buffer_font_size": 15,

  "terminal": {
    "font_family": "CaskaydiaCove Nerd Font",
    "line_height": "standard"
  },

  "theme": {
    "mode": "dark",
    "light": "Nord Light",
    "dark": "Nord Dark"
  },

  "icon_theme": "Catppuccin Frappé",

  "languages": {
    "PHP": {
      "language_servers": ["phpactor", "phpcs"]
    }
  },

  "lsp": {
    "phpactor": {
      "initialization_options": {
        "language_server.diagnostic_ignore_codes": [
          "worse.docblock_missing_param",
          "worse.docblock_missing_return_type"
        ]
      }
    },
    "phpcs": {
      "settings": {
        "standard": "PSR12"
      }
    }
  },

  "project_panel": {
    "hide_hidden": false,
    "hide_root": false,
    "sticky_scroll": true,
    "git_status": true,
    "folder_icons": true,
    "file_icons": true,
    "entry_spacing": "comfortable",
    "hide_gitignore": false,
    "default_width": 350
  },

  "outline_panel": {
    "default_width": 350
  },

  "collaboration_panel": {
    "default_width": 350
  },

  "git_panel": {
    "default_width": 350
  },

  "notification_panel": {
    "default_width": 350
  },

  "agent": {
    "default_width": 350
  }
}
